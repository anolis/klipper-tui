/* Mainsail-inspired dark theme.
   primary #2196f3, surface #1e1e1e, background #121212, logo red #D41216 */

Screen {
    background: #121212;
    color: #e0e0e0;
}

Header {
    background: #1e1e1e;
    color: #ffffff;
}

Footer {
    background: #1e1e1e;
}

/* --- Card / panel chrome ------------------------------------------------- */

.panel {
    background: #1e1e1e;
    border: round #2f2f2f;
    padding: 1 2;
    margin: 0 0 1 0;
    height: auto;
}

.panel-title {
    color: #2196f3;
    text-style: bold;
    padding: 0 0 1 0;
}

.row {
    height: auto;
    width: 100%;
}

.dim {
    color: #9e9e9e;
}

.value {
    color: #ffffff;
    text-style: bold;
}

.hot {
    color: #D41216;
    text-style: bold;
}

.ok {
    color: #4caf50;
}

.warn {
    color: #ff9800;
}

/* --- Buttons ------------------------------------------------------------- */

Button {
    min-width: 10;
    height: 3;
    border: none;
    margin: 0 1 1 0;
    padding: 0 2;
    background: #2a2a2a;
    color: #e0e0e0;
}

Button:hover {
    background: #3a3a3a;
}

Button.-primary {
    background: #2196f3;
    color: #ffffff;
}

Button.-danger {
    background: #D41216;
    color: #ffffff;
}

Button.-success {
    background: #4caf50;
    color: #ffffff;
}

/* --- Tabs ---------------------------------------------------------------- */

Tabs {
    background: #1e1e1e;
}

Tab {
    color: #9e9e9e;
}

Tab.-active {
    color: #2196f3;
    text-style: bold;
}

TabPane {
    padding: 1;
}

/* --- Dashboard layout ---------------------------------------------------- */

#dash-grid {
    layout: grid;
    grid-size: 2;
    grid-gutter: 1;
    grid-columns: 1fr 1fr;
    height: auto;
}

#status-panel {
    height: auto;
}

#temp-panel {
    height: auto;
}

DataTable {
    height: auto;
    max-height: 12;
    background: #1e1e1e;
}

DataTable > .datatable--header {
    background: #1e1e1e;
    color: #2196f3;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #2196f3;
    color: #ffffff;
}

ProgressBar {
    width: 100%;
}

Bar > .bar--bar {
    color: #2196f3;
}

Bar > .bar--complete {
    color: #4caf50;
}

/* --- Console ------------------------------------------------------------- */

#console-log {
    background: #121212;
    border: round #2f2f2f;
    height: 1fr;
}

#console-input {
    background: #1e1e1e;
    border: round #2f2f2f;
}

#console-input:focus {
    border: round #2196f3;
}

Input {
    background: #1e1e1e;
    border: round #2f2f2f;
    color: #e0e0e0;
}

Input:focus {
    border: round #2196f3;
}

/* --- Motion / extruder controls ------------------------------------------ */

.control-grid {
    layout: grid;
    grid-size: 3;
    grid-gutter: 1;
    height: auto;
    width: auto;
}

.btn-row {
    height: auto;
    width: 100%;
}

/* Inputs default to filling their container, which pushes sibling buttons
   off-screen inside a Horizontal row. Give them a fixed width instead. */
.btn-row Input {
    width: 16;
    height: 3;
    margin: 0 1 1 0;
}

/* Rows of many short buttons (presets, jog steps) need tighter chrome or the
   last button overflows the panel. */
.compact-row Button {
    min-width: 7;
    width: auto;
    padding: 0 1;
    margin: 0 1 1 0;
}

.step-row {
    height: auto;
    padding: 1 0 0 0;
}

.step-row Static {
    width: 14;
    height: 3;
    content-align: left middle;
}

.spacer {
    width: 1fr;
}

/* --- Heightmap ----------------------------------------------------------- */

#heightmap {
    height: auto;
    background: #1e1e1e;
    border: round #2f2f2f;
    padding: 1;
}

/* --- Temperature graph --------------------------------------------------- */

#tempgraph-panel {
    padding: 1 2;
}

#tg-legend {
    padding: 0 0 1 0;
}

#tg-chart {
    height: 1fr;
    background: #1a1a1a;
    border: round #2f2f2f;
    padding: 0 1;
}

/* Compact dashboard variant: fixed height, no controls. */
/* Size to content so the panel's own padding cannot clip the chart. */
#tempgraph-dash {
    height: auto;
}

#tempgraph-dash #tg-chart {
    height: 11;
}

/* --- 3D position --------------------------------------------------------- */

#position-panel {
    padding: 1 2;
}

#ps-readout {
    padding: 0 0 1 0;
}

#ps-view {
    height: 1fr;
    background: #0d0d12;
    border: round #ff9966;
    padding: 0 1;
}

/* --- Webcam -------------------------------------------------------------- */

#webcam-panel {
    padding: 1 2;
}

#wc-image {
    width: 100%;
    height: 1fr;
    border: round #2f2f2f;
}

/* --- Files --------------------------------------------------------------- */

#file-table {
    height: 1fr;
    max-height: 100%;
}
