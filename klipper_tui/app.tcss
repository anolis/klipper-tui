/* All colours come from the active theme; see theming.py. */

Screen {
    background: $background;
    color: $foreground;
    overflow: hidden;
}

/* The tab area fills the screen exactly. Without a fixed height it sizes to
   its content and pushes a scrollbar onto the screen itself; scrolling belongs
   to the individual panes. */
TabbedContent {
    height: 1fr;
}

TabbedContent ContentSwitcher {
    height: 1fr;
}

#statusbar {
    height: 1;
    dock: bottom;
}

Header {
    background: $surface;
    color: $foreground;
}

Footer {
    background: $surface;
}

/* --- Card / panel chrome ------------------------------------------------- */

.panel {
    background: $surface;
    border: round $panel-lighten-2;
    padding: 1 2;
    margin: 0 0 1 0;
    height: auto;
}

.panel-title {
    color: $accent;
    text-style: bold;
    padding: 0 0 1 0;
}

.row {
    height: auto;
    width: 100%;
}

.dim {
    color: $text-muted;
}

.value {
    color: $foreground;
    text-style: bold;
}

/* --- Buttons ------------------------------------------------------------- */

Button {
    min-width: 10;
    height: 3;
    border: none;
    margin: 0 1 1 0;
    padding: 0 2;
    background: $panel-lighten-1;
    color: $foreground;
}

Button:hover {
    background: $panel-lighten-3;
}

Button.-primary {
    background: $primary;
    color: $button-color-foreground;
}

Button.-danger {
    background: $error;
    color: $button-color-foreground;
}

Button.-success {
    background: $success;
    color: $button-color-foreground;
}

/* --- Tabs ---------------------------------------------------------------- */

Tabs {
    background: $surface;
}

Tab {
    color: $text-muted;
}

Tab.-active {
    color: $accent;
    text-style: bold;
}

TabPane {
    padding: 1;
    height: 1fr;
    overflow: hidden;
}

/* --- Dashboard layout ---------------------------------------------------- */

#dash-grid {
    layout: grid;
    grid-size: 2;
    grid-gutter: 1;
    grid-columns: 1fr 1fr;
    height: auto;
}

#status-panel, #temp-panel {
    height: auto;
}

DataTable {
    height: auto;
    max-height: 12;
    background: $surface;
}

DataTable > .datatable--header {
    background: $surface;
    color: $accent;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $primary;
    color: $button-color-foreground;
}

ProgressBar {
    width: 100%;
}

Bar > .bar--bar {
    color: $primary;
}

Bar > .bar--complete {
    color: $success;
}

/* --- Console ------------------------------------------------------------- */

#console-log {
    background: $background;
    border: round $panel-lighten-2;
    height: 1fr;
}

Input {
    background: $surface;
    border: round $panel-lighten-2;
    color: $foreground;
}

Input:focus {
    border: round $accent;
}

/* --- Rows of controls ---------------------------------------------------- */

.btn-row {
    height: auto;
    width: 100%;
}

/* Inputs fill their container by default, which pushes sibling buttons off
   the panel inside a Horizontal row. Give them a fixed width instead. */
.btn-row Input {
    width: 16;
    height: 3;
    margin: 0 1 1 0;
}

/* Rows of many short buttons (presets, jog steps) need tighter chrome or the
   last button overflows the panel. */
.compact-row Button {
    min-width: 7;
    width: auto;
    padding: 0 1;
    margin: 0 1 1 0;
}

.step-row {
    height: auto;
    padding: 1 0 0 0;
}

.step-row Static {
    width: 14;
    height: 3;
    content-align: left middle;
}

/* --- Heightmap ----------------------------------------------------------- */

#heightmap {
    height: auto;
    background: $surface;
    border: round $panel-lighten-2;
    padding: 1;
}

/* --- Temperature graph --------------------------------------------------- */

#tempgraph-panel {
    padding: 1 2;
}

#tg-legend {
    padding: 0 0 1 0;
}

#tg-chart {
    height: 1fr;
    background: $surface-darken-1;
    border: round $panel-lighten-2;
    padding: 0 1;
}

/* Size to content so the panel's own padding cannot clip the chart. */
#tempgraph-dash {
    height: auto;
}

#tempgraph-dash #tg-chart {
    height: 11;
}

/* --- Preheat modal ------------------------------------------------------- */

PreheatScreen {
    align: center middle;
}

#preheat-box {
    width: 72;
    height: auto;
    padding: 1 2;
    background: $surface;
    border: thick $warning;
}

/* --- Speed & flow -------------------------------------------------------- */

#tuning-panel {
    height: auto;
}

#tuning-panel Input {
    width: 12;
    height: 3;
    margin: 0 1 1 0;
}

/* --- 3D position --------------------------------------------------------- */

#position-panel {
    padding: 1 2;
    height: auto;
}

#ps-readout {
    padding: 0 0 1 0;
}

/* Tall enough to scroll into a nearly full screen; a 1fr here collapses
   inside the scrolling Move tab. */
#ps-view {
    height: 34;
    background: $background;
    border: round $accent;
    padding: 0 1;
}

/* --- Webcam -------------------------------------------------------------- */

#webcam-panel {
    padding: 1 2;
}

/* Size is set from the frame's aspect ratio at runtime; see webcam.py. */
#wc-image {
    width: auto;
    height: auto;
    border: round $panel-lighten-2;
}

/* --- Files --------------------------------------------------------------- */

#file-table {
    height: 1fr;
    max-height: 100%;
}

/* --- Settings ------------------------------------------------------------ */

.setting-row {
    height: 3;
}

.setting-row Button {
    /* The bullet glyphs are double-width, so 12 wraps the label. */
    min-width: 15;
    width: 15;
}

.setting-label {
    height: 3;
    content-align: left middle;
    color: $foreground;
}

Button.-muted {
    background: $panel;
    color: $text-muted;
}

#settings-panel {
    height: auto;
}

/* --- Panels hosted on the dashboard -------------------------------------- */
/* Tab panels size themselves with 1fr, which cannot work inside a scrolling
   dashboard. Give each a fixed height and card chrome instead. */

.on-dashboard {
    height: auto;
    background: $surface;
    border: round $panel-lighten-2;
    padding: 1 2;
    margin: 0 0 1 0;
}

.on-dashboard #console-log {
    height: 12;
}

.on-dashboard #ps-view {
    height: 28;
}



.on-dashboard #file-table {
    height: 12;
    max-height: 12;
}

/* The generic .btn-row width of 16 is far too narrow for a URL. */
#st-webcam-url {
    width: 1fr;
    min-width: 40;
}
