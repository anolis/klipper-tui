/* All colours come from the active theme; see theming.py. */

Screen {
    background: $background;
    color: $foreground;
    overflow: hidden;
}

/* The tab area fills the screen exactly. Without a fixed height it sizes to
   its content and pushes a scrollbar onto the screen itself; scrolling belongs
   to the individual panes. */
TabbedContent {
    height: 1fr;
}

TabbedContent ContentSwitcher {
    height: 1fr;
}

#statusbar {
    height: 1;
    dock: bottom;
}

Header {
    background: $surface;
    color: $foreground;
}

Footer {
    background: $surface;
}

/* --- Card / panel chrome ------------------------------------------------- */

.panel {
    background: $surface;
    border: round $panel-lighten-2;
    padding: 1 2;
    margin: 0 0 1 0;
    height: auto;
}

.panel-title {
    color: $accent;
    text-style: bold;
    padding: 0 0 1 0;
}

.row {
    height: auto;
    width: 100%;
}

.dim {
    color: $text-muted;
}

.value {
    color: $foreground;
    text-style: bold;
}

/* --- Buttons ------------------------------------------------------------- */

/* Terminal cells cannot round, but a "round" border draws the corner glyphs
   and reads as a rounded button so long as the fill does not run past them —
   hence outlines on the panel ground rather than solid blocks. */
Button {
    min-width: 10;
    height: 3;
    border: round $panel-lighten-3;
    margin: 0 1 0 0;
    padding: 0 1;
    background: $surface;
    color: $foreground;
}

Button:hover {
    border: round $accent;
    background: $panel-lighten-1;
}

Button:focus {
    border: round $accent;
    text-style: bold;
}

Button.-primary {
    border: round $primary;
    color: $text-primary;
}

Button.-danger {
    border: round $error;
    color: $text-error;
}

Button.-success {
    border: round $success;
    color: $text-success;
}

Button.-muted {
    border: round $panel-lighten-1;
    color: $text-muted;
}

Button:disabled {
    border: round $panel;
    color: $text-disabled;
}

/* --- Tabs ---------------------------------------------------------------- */

Tabs {
    background: $surface;
}

Tab {
    color: $text-muted;
}

Tab.-active {
    color: $accent;
    text-style: bold;
}

TabPane {
    padding: 1;
    height: 1fr;
    overflow: hidden;
}

/* --- Dashboard layout ---------------------------------------------------- */

#dash-grid {
    layout: grid;
    grid-size: 2;
    grid-gutter: 1;
    grid-columns: 1fr 1fr;
    height: auto;
}

#status-panel, #temp-panel {
    height: auto;
}

DataTable {
    height: auto;
    max-height: 12;
    background: $surface;
}

DataTable > .datatable--header {
    background: $surface;
    color: $accent;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $primary;
    color: $button-color-foreground;
}

ProgressBar {
    width: 100%;
}

Bar > .bar--bar {
    color: $primary;
}

Bar > .bar--complete {
    color: $success;
}

/* --- Console ------------------------------------------------------------- */

#console-log {
    background: $background;
    border: round $panel-lighten-2;
    height: 1fr;
}

Input {
    background: $surface;
    border: round $panel-lighten-2;
    color: $foreground;
}

Input:focus {
    border: round $accent;
}

/* --- Rows of controls ---------------------------------------------------- */

.btn-row {
    height: auto;
    width: 100%;
}

/* Inputs fill their container by default, which pushes sibling buttons off
   the panel inside a Horizontal row. Give them a fixed width instead. */
.btn-row Input {
    width: 16;
    height: 3;
    margin: 0 1 1 0;
}

/* Rows of many short buttons (presets, jog steps) need tighter chrome or the
   last button overflows the panel. */
.compact-row Button {
    min-width: 9;
    width: auto;
    padding: 0 1;
    margin: 0 1 0 0;
}

.step-row {
    height: auto;
    padding: 1 0 0 0;
}

.step-row Static {
    width: 14;
    height: 3;
    content-align: left middle;
}

/* --- Heightmap ----------------------------------------------------------- */

#heightmap {
    height: auto;
    background: $surface;
    border: round $panel-lighten-2;
    padding: 1;
}

/* --- Temperature graph --------------------------------------------------- */

#tempgraph-panel {
    padding: 1 2;
}

#tg-legend {
    padding: 0 0 1 0;
}

#tg-chart {
    height: 1fr;
    background: $surface-darken-1;
    border: round $panel-lighten-2;
    padding: 0 1;
}

/* Size to content so the panel's own padding cannot clip the chart. */
#tempgraph-dash {
    height: auto;
}

#tempgraph-dash #tg-chart {
    height: 11;
}

/* --- Preheat modal ------------------------------------------------------- */

PreheatScreen {
    align: center middle;
}

#preheat-box {
    width: 72;
    height: auto;
    padding: 1 2;
    background: $surface;
    border: thick $warning;
}

/* --- Speed & flow -------------------------------------------------------- */

#tuning-panel {
    height: auto;
}

#tuning-panel Input {
    width: 12;
    height: 3;
    margin: 0 1 1 0;
}

/* --- 3D position --------------------------------------------------------- */

#position-panel {
    padding: 1 2;
    height: auto;
}

#ps-readout {
    padding: 0 0 1 0;
}

/* Tall enough to scroll into a nearly full screen; a 1fr here collapses
   inside the scrolling Move tab. */
#ps-view {
    height: 34;
    background: $background;
    border: round $accent;
    padding: 0 1;
}

/* --- Webcam -------------------------------------------------------------- */

#webcam-panel {
    padding: 1 2;
}

/* Size is set from the frame's aspect ratio at runtime; see webcam.py. */
#wc-image {
    width: auto;
    height: auto;
    border: round $panel-lighten-2;
}

/* --- Files --------------------------------------------------------------- */

#file-table {
    height: 1fr;
    max-height: 100%;
}

/* --- Settings ------------------------------------------------------------ */

.setting-row {
    height: 3;
}

.setting-row Button {
    /* Bullet glyphs are double-width and the border takes two more columns. */
    min-width: 17;
    width: 17;
}

.setting-label {
    height: 3;
    content-align: left middle;
    color: $foreground;
}

#settings-panel {
    height: auto;
}

/* --- Panels hosted on the dashboard -------------------------------------- */
/* Tab panels size themselves with 1fr, which cannot work inside a scrolling
   dashboard. Give each a fixed height and card chrome instead. */

.on-dashboard {
    height: auto;
    background: $surface;
    border: round $panel-lighten-2;
    padding: 1 2;
    margin: 0 0 1 0;
}

.on-dashboard #console-log {
    height: 12;
}

.on-dashboard #ps-view {
    height: 28;
}



.on-dashboard #file-table {
    height: 12;
    max-height: 12;
}

/* The generic .btn-row width of 16 is far too narrow for a URL. */
#st-webcam-url {
    width: 1fr;
    min-width: 40;
}

#bm-count {
    width: 28;
}

ConfirmScreen {
    align: center middle;
}

#confirm-box {
    width: 68;
    height: auto;
    padding: 1 2;
    background: $surface;
    border: thick $warning;
}

/* A short caption in a button row must be given a width, or it expands and
   pushes the buttons out of the panel. */
.row-label {
    width: 6;
    height: 3;
    content-align: left middle;
    color: $text-muted;
}

OfflineScreen {
    align: center middle;
}

#offline-box {
    width: 76;
    height: auto;
    padding: 1 2;
    background: $surface;
    border: thick $error;
}

/* --- Material preset editor ---------------------------------------------- */

#st-preset-list {
    height: auto;
    max-height: 24;
}

/* Outranks the generic ".btn-row Input" width, which is a type selector and
   would otherwise win. */
.btn-row Input.preset-name {
    width: 22;
}

.btn-row Input.preset-temp {
    width: 13;
}

#st-preset-new-name {
    width: 20;
}

/* --- Toolpath viewer ------------------------------------------------------ */

#gcodeview-panel {
    height: auto;
}

#gv-view {
    height: 30;
    background: $background;
    border: round $panel-lighten-2;
    padding: 0 1;
}

.on-dashboard #gv-view {
    height: 22;
}

/* --- Motion limits -------------------------------------------------------- */

.limit-label {
    width: 26;
    height: 3;
    content-align: left middle;
    color: $foreground;
}

.btn-row Input.limit-input {
    width: 14;
}

.limit-unit {
    width: 8;
    height: 3;
    content-align: left middle;
}

#machine-panel {
    height: auto;
}

#fans-panel, #fn-list {
    height: auto;
}

.btn-row Input.fan-input {
    width: 9;
}

/* Panels packed side by side share the row evenly. */
.dash-row {
    height: auto;
    width: 100%;
}

/* Widths are set per panel when the row is built, in proportion to what each
   one needs; see PANEL_MIN_WIDTH. */
